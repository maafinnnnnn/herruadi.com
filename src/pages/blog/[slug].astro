---
import { getCollection, render } from 'astro:content';
import RedlineLayout from '../../layouts/RedlineLayout.astro';
import RedlineCTA from '../../components/redline/RedlineCTA.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const toSlug = (s: string) => s.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
const related = allPosts
  .filter((p) => p.id !== post.id && toSlug(p.data.category) === toSlug(post.data.category))
  .slice(0, 2);

const pubDateFormatted = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const pageUrl = Astro.url.href;
const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(post.data.title)}`;
const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
---

<RedlineLayout title={`${post.data.title} · Herru Adi`} description={post.data.description} active="blog">
  <!-- ============ ARTICLE HERO ============ -->
  <section class="page-hero">
    <div class="back-crumb">
      <a href="/blog">← Blog</a>
      <span class="sep">·</span>
      <span class="meta">{post.data.category}</span>
      <span class="sep">·</span>
      <span class="meta">{pubDateFormatted}</span>
    </div>
    <h1 class="page-title" style="max-width: 22ch;">{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <p class="tags" style="margin-top:20px;">
        {post.data.tags.map((tag) => <span>#{tag}</span>)}
      </p>
    )}
  </section>

  <!-- ============ ARTICLE BODY ============ -->
  <div style="padding:44px 0;">
    <article class="doc-prose">
      <Content />
    </article>
  </div>

  <!-- ============ SHARE ============ -->
  <div style="padding-bottom:48px; border-top:1px solid var(--line); padding-top:36px;">
    <p class="eyebrow" style="margin-bottom:18px;">Share this article</p>
    <div style="display:flex; flex-wrap:wrap; gap:10px;">
      <a href={twitterUrl} target="_blank" rel="noopener noreferrer" class="social-chip">Share on X</a>
      <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="social-chip">Share on LinkedIn</a>
      <button id="copy-link-btn" class="social-chip" style="cursor:pointer; background:none;">
        <span id="copy-label">Copy link</span>
      </button>
    </div>
  </div>

  <!-- ============ RELATED ============ -->
  {related.length > 0 && (
    <section style="border-top:1.5px solid var(--line-strong);">
      <div class="section-head">
        <div>
          <p class="tag mono upper">Next</p>
          <h2>More field notes.</h2>
        </div>
      </div>
      {related.map((rel) => (
        <a class="note" href={`/blog/${rel.id}`}>
          <span class="note-cat">{rel.data.category}</span>
          <span class="note-title">{rel.data.title}</span>
          <span class="note-arrow">read →</span>
        </a>
      ))}
    </section>
  )}

  <RedlineCTA />
</RedlineLayout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyLabel = document.getElementById('copy-label');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (copyLabel) {
        copyLabel.textContent = 'Copied!';
        setTimeout(() => {
          copyLabel.textContent = 'Copy link';
        }, 2000);
      }
    } catch {
      prompt('Copy this link:', window.location.href);
    }
  });
</script>
