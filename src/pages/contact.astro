---
import RedlineLayout from '../layouts/RedlineLayout.astro';

const expectations = [
  "I'll respond within 1-2 business days",
  'First call is always a conversation, never a pitch',
  "If I'm not the right fit, I'll tell you honestly",
];

const socialLinks = [
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/herruadivian/',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    name: 'Dribbble',
    href: 'https://dribbble.com/herruadi',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M19.13 5.09C15.22 9.14 10 10.44 2.25 10.94"/><path d="M21.75 12.84c-6.62-1.41-12.14 1-16.38 6.32"/><path d="M8.56 2.75c4.37 6 6 9.42 8 17.72"/></svg>`,
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/maafinnnn/',
    icon: `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
  },
];
---

<RedlineLayout
  title="Let's Talk · Herru Adi"
  description="I take on a limited number of projects at a time. Tell me what you're working on."
  active="contact"
>
  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      padding: 56px 0 60px;
    }
    @media (max-width: 900px) {
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 40px;
      }
    }
    .contact-block {
      margin-bottom: 34px;
    }
  </style>

  <section class="page-hero" style="border-bottom:none;">
    <p class="eyebrow">Contact / Sign-Off</p>
    <h1 class="page-title">Tell me what you're building.</h1>
    <p class="page-lead">
      I take on a limited number of projects at a time, so if you're reading this, there's a good
      chance I have room for one more.
    </p>
  </section>

  <div class="contact-grid" style="border-top:1.5px solid var(--line-strong);">
    <!-- ─── Left column ─────────────────────────────────────────── -->
    <div>
      <div class="contact-block">
        <p class="eyebrow" style="margin-bottom:16px;">What to Expect</p>
        <ul class="check-list">
          {expectations.map((item) => (
            <li class="check-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="contact-block">
        <p class="eyebrow" style="margin-bottom:16px;">Find Me Online</p>
        <div class="social-row">
          {socialLinks.map((link) => (
            <a href={link.href} class="social-chip" target="_blank" rel="noopener noreferrer">
              <Fragment set:html={link.icon} />
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- ─── Right column: form ──────────────────────────────────── -->
    <div>
      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST" novalidate>
        <input type="hidden" name="access_key" value="300403c4-ddf2-4986-a35d-55bf68d27dc4" />
        <input type="hidden" name="subject" value="New inquiry from herruadi.com" />
        <input type="hidden" name="from_name" value="herruadi.com contact form" />
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="form-field">
          <label for="name">Name <span class="required" aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" placeholder="Your full name" />
        </div>

        <div class="form-field">
          <label for="email">Email <span class="required" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
        </div>

        <div class="form-field">
          <label for="project">What are you working on? <span class="required" aria-hidden="true">*</span></label>
          <textarea
            id="project"
            name="project"
            required
            rows="4"
            placeholder="Tell me about your product, team, and where you're at right now..."
          ></textarea>
        </div>

        <div class="form-field">
          <label for="success">What does success look like for you? <span style="text-transform:none; letter-spacing:0; color:var(--ink-faint);">(optional)</span></label>
          <textarea id="success" name="success" rows="3" placeholder="What's the outcome you're hoping for?"></textarea>
        </div>

        <div class="submit-row">
          <button type="submit" class="sig-link" id="contact-submit">Send message →</button>
          <p class="form-footnote">Powered by Web3Forms</p>
          <p id="form-error" class="form-error" role="alert" hidden></p>
        </div>
      </form>

      <div id="form-success" class="stamp" style="max-width:100%; margin-top:8px;" hidden>
        <p class="sund" style="font-size:1.5rem;">Message Received.</p>
        <p class="eng mono">Thanks, I'll get back to you within 2 business days.</p>
      </div>
    </div>
  </div>
</RedlineLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const errorBox = document.getElementById('form-error');
  const successBox = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !errorBox) return;

    const formData = new FormData(form);
    const accessKey = String(formData.get('access_key') ?? '');

    errorBox.hidden = true;

    if (!accessKey || accessKey.startsWith('YOUR_')) {
      errorBox.textContent = "This form isn't connected yet, add a Web3Forms access key to finish setup.";
      errorBox.hidden = false;
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const json = await res.json();

      if (json.success) {
        form.hidden = true;
        if (successBox) successBox.hidden = false;
      } else {
        throw new Error(json.message || 'Something went wrong.');
      }
    } catch (err) {
      errorBox.textContent = "Couldn't send, sorry. Try again, or email me directly.";
      errorBox.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send message →';
    }
  });
</script>
