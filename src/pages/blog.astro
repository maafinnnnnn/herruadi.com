---
import { getCollection } from 'astro:content';
import RedlineLayout from '../layouts/RedlineLayout.astro';
import RedlineCTA from '../components/redline/RedlineCTA.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const toSlug = (s: string) => s.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

const categories = [
  { label: 'All', slug: 'all' },
  { label: 'Business x Design', slug: 'business-x-design' },
  { label: 'Field Notes', slug: 'field-notes' },
  { label: 'Process', slug: 'process' },
];
---

<RedlineLayout
  title="Field Notes · Herru Adi"
  description="Design, business, and the conversations worth having."
  active="blog"
>
  <!-- ============ PAGE HERO ============ -->
  <section class="page-hero">
    <p class="eyebrow">Field Notes</p>
    <h1 class="page-title">Thinking out loud, in writing.</h1>
    <p class="page-lead">Design, business, and the conversations worth having.</p>
  </section>

  <!-- ============ FILTER TABS ============ -->
  <div style="padding:32px 0;">
    <div class="filter-tabs" role="tablist" aria-label="Filter articles by category">
      {categories.map((cat, i) => (
        <button data-filter={cat.slug} role="tab" aria-selected={i === 0 ? 'true' : 'false'} class="filter-tab">
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- ============ POSTS ============ -->
  <section>
    {posts.map((post) => (
      <a
        class="post-row"
        href={`/blog/${post.id}`}
        data-category={toSlug(post.data.category)}
      >
        <span class="post-date mono">
          {new Date(post.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
        </span>
        <span>
          <span class="post-cat">{post.data.category}</span>
          <span class="post-title">{post.data.title}</span>
          <span class="post-desc">{post.data.description}</span>
        </span>
        <span class="post-arrow">read →</span>
      </a>
    ))}

    <div id="empty-state" class="hidden" style="padding:60px 0; text-align:center;" aria-live="polite">
      <p style="font-family:var(--body); color:var(--ink-soft);">No articles in this category yet.</p>
      <p class="mono" style="font-size:12px; color:var(--ink-faint); margin-top:6px;">Check back soon.</p>
    </div>
  </section>

  <RedlineCTA />
</RedlineLayout>

<style>
  #empty-state.hidden {
    display: none;
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const postRows = document.querySelectorAll<HTMLElement>('[data-category]');
  const emptyState = document.getElementById('empty-state');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';

      filterBtns.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));

      let visible = 0;
      postRows.forEach((row) => {
        const match = filter === 'all' || row.dataset.category === filter;
        row.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      emptyState?.classList.toggle('hidden', visible > 0);
    });
  });
</script>
