---
import '../styles/global.css';
import '../styles/redline.css';
import '../styles/redaction-run.css';
import SEO from '../components/SEO.astro';
import RedlineHeader from '../components/redline/RedlineHeader.astro';
import RedlineFoot from '../components/redline/RedlineFoot.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'work' | 'about' | 'blog' | 'hire' | 'contact' | '';
  image?: string;
  lang?: string;
  locale?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
}

const {
  title = 'Herru Adi · Strategic Design Partner',
  description = "I help teams figure out what to build, how to build it, and why it matters. Then I make it real.",
  active = '',
  image = '/og/index.png',
  lang = 'en',
  locale = 'en_US',
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js). Only loaded on the production hostnames, so local
         dev servers and preview deploys never send hits. gtag() is always
         defined, so event calls elsewhere stay harmless no-ops when GA4 is off. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      if (location.hostname === 'herruadi.com' || location.hostname === 'www.herruadi.com') {
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-HZGPSPWPF4';
        document.head.appendChild(gaScript);
        gtag('js', new Date());
        gtag('config', 'G-HZGPSPWPF4');
      }
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      image={image}
      locale={locale}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      section={section}
      tags={tags}
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Herru Adi — Field Notes" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Martian+Mono:wdth,wght@87.5,400..600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
    <slot name="head" />
    <script is:inline>
      (function () {
        try {
          if (location.pathname !== '/') return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('signal-rr-played')) return;
          sessionStorage.setItem('signal-rr-played', '1');
          document.documentElement.dataset.rr = 'play';
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <RedlineHeader active={active} />
    <main class="wrap">
      <slot />
    </main>
    <RedlineFoot />
  </body>
</html>
