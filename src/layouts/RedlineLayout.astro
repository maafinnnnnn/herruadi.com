---
import '../styles/global.css';
import '../styles/redline.css';
import '../styles/redaction-run.css';
import SEO from '../components/SEO.astro';
import RedlineHeader from '../components/redline/RedlineHeader.astro';
import RedlineFoot from '../components/redline/RedlineFoot.astro';

interface Props {
  title?: string;
  description?: string;
  active?: 'work' | 'about' | 'blog' | 'contact' | '';
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = 'Herru Adi · Strategic Design Partner',
  description = "I help startups and growing teams figure out what to build, how to build it, and why it matters. Then I make it real.",
  active = '',
  image = '/og/index.png',
  type = 'website',
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HZGPSPWPF4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-HZGPSPWPF4');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <SEO title={title} description={description} canonicalURL={canonicalURL} image={image} type={type} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Herru Adi — Field Notes" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Martian+Mono:wdth,wght@87.5,400..600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (_) {}
      })();
    </script>
    <script is:inline>
      (function () {
        try {
          if (location.pathname !== '/') return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('signal-rr-played')) return;
          sessionStorage.setItem('signal-rr-played', '1');
          document.documentElement.dataset.rr = 'play';
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <RedlineHeader active={active} />
    <main class="wrap">
      <slot />
    </main>
    <RedlineFoot />
  </body>
</html>
