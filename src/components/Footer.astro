---
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 px-6 sm:flex-row">
    <div class="flex flex-col items-center gap-1 sm:items-start">
      <span class="text-sm font-semibold text-fg">Herru Adi</span>
      <p class="text-xs text-muted">© {year} · Strategic Design Partner</p>
    </div>

    <nav class="flex items-center gap-6" aria-label="Footer navigation">
      <a href="/work"    class="text-sm text-muted transition-colors duration-200 hover:text-fg">Work</a>
      <a href="/about"   class="text-sm text-muted transition-colors duration-200 hover:text-fg">About</a>
      <a href="/blog"    class="text-sm text-muted transition-colors duration-200 hover:text-fg">Blog</a>
      <a href="/contact" class="text-sm text-muted transition-colors duration-200 hover:text-fg">Contact</a>
    </nav>
  </div>
</footer>
