---
const projects = [
  {
    label: 'F&B SaaS · UI/UX Lead',
    title: 'AYCE',
    oneliner: 'Turning the chaos of kitchen operations into a system so simple, it runs itself.',
    tags: ['SaaS', 'Operations Design', '0-to-1'],
    href: '/work/ayce',
    gradient: 'linear-gradient(135deg, #FF6B35 0%, #F7931E 100%)',
  },
  {
    label: 'Property Management System · Product Design Lead',
    title: 'Hoteely',
    oneliner: 'Transforming hotel management chaos into one clean, intuitive screen.',
    tags: ['Enterprise', 'Dashboard Design', 'Middle East'],
    href: '/work/hoteely',
    gradient: 'linear-gradient(135deg, #0EA5E9 0%, #0369A1 100%)',
  },
  {
    label: 'AI Crypto Dashboard · Solo Designer',
    title: 'Vantagelab',
    oneliner: "Making sense of crypto market noise — for a first-time designer in the blockchain space who refused to let complexity win.",
    tags: ['AI', 'Data Visualization', 'UK Client'],
    href: '/work/vantagelab',
    gradient: 'linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%)',
  },
];
---

<section id="work" class="py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-6">

    <!-- Section header -->
    <div class="mb-14 md:mb-16">
      <p class="mb-3 font-mono text-xs font-medium uppercase tracking-[0.2em] text-muted">
        Selected Work
      </p>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-3xl font-bold tracking-tight text-fg sm:text-4xl">
          A small collection of projects<br class="hidden sm:block" />
          where design met real business challenges.
        </h2>
        <a
          href="/work"
          class="group inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-accent transition-all duration-200"
        >
          View all work
          <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {projects.map((project) => (
        <article class="group flex flex-col overflow-hidden rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-accent/20 hover:shadow-xl hover:shadow-black/5 dark:hover:shadow-black/30">

          <!-- Gradient thumbnail -->
          <div
            class="relative aspect-video w-full overflow-hidden"
            style={`background: ${project.gradient}`}
          >
            <span class="absolute bottom-5 left-5 font-bold text-white/10 text-7xl leading-none select-none">
              {project.title}
            </span>
          </div>

          <!-- Content -->
          <div class="flex flex-1 flex-col p-6">
            <p class="mb-2 font-mono text-xs text-muted">{project.label}</p>
            <h3 class="mb-3 text-xl font-bold text-fg">{project.title}</h3>
            <p class="mb-5 flex-1 text-sm leading-relaxed text-muted">{project.oneliner}</p>

            <!-- Tags -->
            <div class="mb-5 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="rounded-full border border-border px-3 py-1 text-xs font-medium text-muted">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Link -->
            <a
              href={project.href}
              class="group/link inline-flex items-center gap-2 text-sm font-semibold text-accent transition-all duration-200"
            >
              View case study
              <span aria-hidden="true" class="transition-transform duration-200 group-hover/link:translate-x-0.5">→</span>
            </a>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
