];
---

<footer class="page-foot">
  <div class="wrap">
    <div class="foot-top">
      <div class="foot-brand">
        <span class="foot-name">Herru Adi</span>
        <span class="foot-meta">Bandung, Indonesia · Available for Q4 2026</span>
        <div class="foot-social">
          {socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.name}>
              <Fragment set:html={link.icon} />
            </a>
          ))}
        </div>
      </div>
      <nav aria-label="Footer navigation" class="foot-nav">
        <a href="/work">Work</a>
        <span class="sep">·</span>
        <a href="/about">About</a>
        <span class="sep">·</span>
        <a href="/blog">Blog</a>
        <span class="sep">·</span>
        <a href="/contact">Contact</a>
      </nav>
    </div>
    <div class="foot-bottom">
      <span>© {year} Herru Adi · Built with intention, not just Figma.</span>
    </div>
  </div>
</footer>
