---
interface Props {
  heading?: string;
  lead?: string;
}
const {
  heading = 'Got a problem worth diagnosing?',
  lead = "If the brief needs interrogating before it needs designing, that's the conversation to start.",
} = Astro.props;
---

<section class="signoff" id="contact-cta">
  <div class="wrap">
    <div class="signoff-grid">
      <div>
        <h2>{heading}</h2>
        <p class="lead">{lead}</p>
        <div class="sig-line">
          <a class="sig-link" href="/contact">Start the conversation →</a>
          <p class="sig-sub">Response within 2 business days · GMT+7</p>
        </div>
      </div>
      <div class="signoff-fields">
        <div class="field"><dt class="tb-label">Status</dt><dd>Reviewing new engagements, Q4 2026</dd></div>
        <div class="field"><dt class="tb-label">Fit</dt><dd>Startups &amp; growing teams deciding what to build next</dd></div>
        <div class="field"><dt class="tb-label">Also a fit</dt><dd>Execution that needs strategic oversight, not just delivery</dd></div>
      </div>
    </div>
  </div>
</section>
