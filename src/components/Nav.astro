---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-border/50 bg-bg/80 backdrop-blur-xl">

  <!-- ── Main bar ──────────────────────────────────────────────────── -->
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a
      href="/"
      class="text-[15px] font-semibold tracking-tight text-fg transition-colors hover:text-accent"
    >
      Herru Adi
    </a>

    <!-- Right side: groups desktop nav + toggle + hamburger as one flex child -->
    <div class="flex items-center gap-1">

      <!-- Desktop nav links (md+) -->
      <nav class="hidden items-center gap-0.5 md:flex" aria-label="Main navigation">
        <a href="/work"  class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-fg">Work</a>
        <a href="/about" class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-fg">About</a>
        <a href="/blog"  class="rounded-lg px-3 py-2 text-sm font-medium text-muted transition-colors hover:bg-surface hover:text-fg">Blog</a>
        <span class="mx-2 h-4 w-px bg-border" aria-hidden="true"></span>
        <a
          href="/contact"
          class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Let's talk
        </a>
      </nav>

      <!-- ThemeToggle: always visible (mobile: left of hamburger, desktop: after nav) -->
      <ThemeToggle />

      <!-- Mobile: hamburger button (below md) -->
    <button
      id="hamburger-btn"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="rounded-lg p-2 text-muted transition-colors hover:bg-surface hover:text-fg md:hidden"
    >
      <!-- Hamburger icon (shown when menu is closed) -->
      <svg
        id="icon-hamburger"
        width="20" height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <!-- Close icon (shown when menu is open) -->
      <svg
        id="icon-close"
        width="20" height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        class="hidden"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    </div><!-- end right-side group -->
  </div><!-- end main bar -->

  <!-- ── Mobile menu dropdown ─────────────────────────────────────── -->
  <!--
    data-[open=false]: invisible, no pointer events, shifted up
    data-[open=true]:  visible, interactive, in place
    transition-all gives the smooth animation
  -->
  <div
    id="mobile-menu"
    data-open="false"
    aria-hidden="true"
    class="absolute inset-x-0 top-full border-b border-border bg-surface/95 backdrop-blur-xl
           transition-all duration-200 ease-out md:hidden
           data-[open=false]:invisible data-[open=false]:opacity-0 data-[open=false]:pointer-events-none data-[open=false]:-translate-y-2
           data-[open=true]:visible   data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto data-[open=true]:translate-y-0"
  >
    <nav
      class="mx-auto max-w-6xl px-6 pb-5 pt-2"
      aria-label="Mobile navigation"
    >
      <!-- Nav links -->
      <div class="flex flex-col">
        <a href="/work"  class="menu-link rounded-lg px-3 py-3 text-base font-medium text-fg transition-colors hover:bg-bg">Work</a>
        <a href="/about" class="menu-link rounded-lg px-3 py-3 text-base font-medium text-fg transition-colors hover:bg-bg">About</a>
        <a href="/blog"  class="menu-link rounded-lg px-3 py-3 text-base font-medium text-fg transition-colors hover:bg-bg">Blog</a>
      </div>

      <!-- CTA + theme toggle -->
      <div class="mt-3 flex flex-col gap-3 border-t border-border pt-4">
        <a
          href="/contact"
          class="menu-link flex items-center justify-center gap-2 rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Let's talk
        </a>
      </div>
    </nav>
  </div>

</header>

<script>
  (function () {
    const btn        = document.getElementById('hamburger-btn');
    const menu       = document.getElementById('mobile-menu');
    const iconOpen   = document.getElementById('icon-hamburger');
    const iconClose  = document.getElementById('icon-close');
    if (!btn || !menu || !iconOpen || !iconClose) return;

    function open() {
      menu.dataset.open = 'true';
      menu.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
    }

    function close() {
      menu.dataset.open = 'false';
      menu.setAttribute('aria-hidden', 'true');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
    }

    // Toggle on button click
    btn.addEventListener('click', () => {
      menu.dataset.open === 'true' ? close() : open();
    });

    // Close when any link in the menu is clicked
    menu.querySelectorAll('.menu-link').forEach(link => {
      link.addEventListener('click', close);
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!menu.contains(target) && !btn.contains(target) && menu.dataset.open === 'true') {
        close();
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.dataset.open === 'true') {
        close();
        btn.focus();
      }
    });
  })();
</script>
